# 服务监听配置
HOST=127.0.0.1
PORT=8421

# SQLite 数据库文件路径(相对项目根目录)
DB_PATH=weights.db

# 日志文件路径
LOG_PATH=logs/app.log

# 移动平均计算窗口(逗号分隔, 单位: 天)
MA_WINDOWS=3,7

# 达标/维持判定的区间半宽(kg): 最大窗口均值进入 [目标-band, 目标+band] 即视为达标,
# 之后"目标进度"卡从减重进度切换为维持情况, 使目标达成后该卡片仍有效。
TARGET_BAND=1.0

# 是否开启热重载(开发用 true, 后台运行保持 false)
RELOAD=false
